{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "rootDir": "Scripts",
    "outDir": "wwwroot/js",
    "removeComments": false,
    "newLine": "lf"
  },
  "include": ["Scripts/**/*.ts"]
}
