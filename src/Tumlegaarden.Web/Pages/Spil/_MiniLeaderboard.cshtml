@model Tumlegaarden.Web.Pages.Spil.MiniLeaderboard
<section class="window" id="highscore">
    <h2 class="window-title">Highscore</h2>
    <div class="window-body">
        @if (Model.Rows.Count == 0)
        {
            <p class="hint">Ingen har spillet endnu. Bliv den første på listen.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="leaderboard">
                    <thead><tr><th>#</th><th>Spiller</th><th>Point</th><th>Spillet</th><th>@Model.WonHeader</th><th>@Model.BestHeader</th><th>I dag</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < Model.Rows.Count; i++)
                        {
                            var r = Model.Rows[i];
                            <tr class="@(r.UserId == Model.MyId ? "is-me" : "")">
                                <td class="num">@(i + 1)</td>
                                <td>@r.Name</td>
                                <td class="num"><strong>@r.Points</strong></td>
                                <td class="num">@r.Played</td>
                                <td class="num">@r.Won</td>
                                <td class="num">@r.Best</td>
                                <td class="num">@r.Today</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <p class="hint">@Model.Note</p>
    </div>
</section>
