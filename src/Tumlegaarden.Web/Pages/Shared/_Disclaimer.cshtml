@using Tumlegaarden.Web.Security
@* Vises ved første besøg. Ingen JavaScript: siden bag er gjort inert i layoutet, og OK sender en formular. *@
<div class="modal-backdrop">
    <section class="window modal" role="dialog" aria-modal="true" aria-labelledby="disclaimer-title" aria-describedby="disclaimer-text">
        <h2 class="window-title" id="disclaimer-title">Privat side</h2>
        <div class="window-body" id="disclaimer-text">
            <p><strong>Tumlegaarden er en privat side uden kommercielle interesser.</strong></p>
            <p>Siden er kun for inviterede brugere. Har du ikke fået en invitation, skal du forlade siden.</p>
            <p class="hint">Siden bruger kun nødvendige cookies til login og sikkerhed. Ingen statistik, ingen markedsføring, ingen tredjepartscookies. <a asp-page="/Cookies">Læs mere om cookies og privatliv</a></p>
            <form method="post" asp-page="/Cookies" asp-page-handler="Disclaimer">
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <div class="actions"><button type="submit" class="btn btn-primary" autofocus>OK, forstået</button></div>
            </form>
        </div>
    </section>
</div>
