@using Tumlegaarden.Web.Security
@{
    var signedIn = User.Identity?.IsAuthenticated == true && User.HasClaim("amr", "mfa");
    var role = Roles.All.FirstOrDefault(User.IsInRole);
    var status = TempData["Status"] as string;
    // Disclaimeren vises ved første besøg – undtagen på cookie-siden, som den linker til.
    var showDisclaimer = !Context.Request.Cookies.ContainsKey(CookieNotice.DisclaimerCookieName)
                         && !string.Equals(Context.Request.Path, "/Cookies", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Tumlegaarden" : "Tumlegaarden")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <div class="page" inert="@showDisclaimer">
    <header class="topbar">
        <h1 class="logo"><a asp-page="/Index">Tumlegaarden</a></h1>
        @if (signedIn)
        {
            <nav class="topnav" aria-label="Hovedmenu">
                <a asp-page="/Index">Kalender</a>
                <a asp-page="/Albums/Index">Albums</a>
                <a asp-page="/Users">Brugere</a>
                <span class="who">@User.Identity!.Name</span>
                @if (role is not null)
                {
                    <span class="role role-@role.ToLowerInvariant().Replace("ø", "o")">@role</span>
                }
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="btn btn-small">Log ud</button>
                </form>
            </nav>
        }
    </header>

    <main class="stage">
        @if (!string.IsNullOrEmpty(status))
        {
            <p class="msg msg-ok status" role="status">@status</p>
        }
        @RenderBody()
    </main>

    <footer class="footer"><a asp-page="/Cookies">Cookies og privatliv</a></footer>
    @if (!showDisclaimer)
    {
        <partial name="_CookieNotice" />
    }
  </div>
  @if (showDisclaimer)
  {
      <partial name="_Disclaimer" />
  }
</body>
</html>
