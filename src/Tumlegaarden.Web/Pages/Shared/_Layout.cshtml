@using Tumlegaarden.Web.Security
@inject Tumlegaarden.Web.Services.PresenceTracker Presence
@{
    var signedIn = User.Identity?.IsAuthenticated == true && User.HasClaim("amr", "mfa");
    var role = Roles.All.FirstOrDefault(User.IsInRole);
    var status = TempData["Status"] as string;
    // Disclaimeren vises ved første besøg – undtagen på cookie-siden, som den linker til.
    var showDisclaimer = !Context.Request.Cookies.ContainsKey(CookieNotice.DisclaimerCookieName)
                         && !string.Equals(Context.Request.Path, "/Cookies", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Tumlegaarden" : "Tumlegaarden")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <div class="page@(signedIn ? " signed-in" : "")" inert="@showDisclaimer">
    <header class="topbar">
        <h1 class="logo"><a asp-page="/Index">Tumlegaarden</a></h1>
        @if (signedIn)
        {
            <form method="post" asp-page="/Account/Logout" class="logout">
                <button type="submit" class="btn btn-small">Log ud</button>
            </form>
            <nav class="topnav" aria-label="Hovedmenu">
                <a asp-page="/Index" class="nav-home" aria-current="@(Context.Request.Path == "/" ? "page" : null)">Start</a>
                @{
                    var path = Context.Request.Path;
                    var inOrdjagt = path.StartsWithSegments("/Ordjagt");
                    var inAfterDark = path.StartsWithSegments("/AfterDark");
                    var inSpil = path.StartsWithSegments("/Spil") || path.StartsWithSegments("/Quiz");
                    string? Current(string page) => path.Equals(page, StringComparison.OrdinalIgnoreCase) ? "page" : null;
                }
                <details class="nav-menu">
                    <summary class="nav-game@(inOrdjagt || inAfterDark || inSpil ? " is-current" : "")">Spil</summary>
                    <ul class="nav-menu-list">
                        <li><a asp-page="/Game/Index" aria-current="@(inOrdjagt ? "page" : null)">Ordjagt <small>dagens ord</small></a></li>
                        <li><a asp-page="/Game/AfterDark" class="nav-afterdark" aria-current="@(inAfterDark ? "page" : null)">Ordjagt After Dark <small>18+</small></a></li>
                        <li class="nav-menu-sep" role="separator"></li>
                        <li><a asp-page="/Spil/Gaade" aria-current="@Current("/Spil/Gaade")">Dagens gåde <small>ordsprog</small></a></li>
                        <li><a asp-page="/Spil/Kode" aria-current="@Current("/Spil/Kode")">Kodeknækker <small>farver</small></a></li>
                        <li><a asp-page="/Spil/Kort" aria-current="@Current("/Spil/Kort")">Højere eller lavere <small>kort</small></a></li>
                        <li><a asp-page="/Spil/Anagram" aria-current="@Current("/Spil/Anagram")">Anagram <small>7 bogstaver</small></a></li>
                        <li class="nav-menu-sep" role="separator"></li>
                        <li><a asp-page="/Quiz/Index" aria-current="@(path.StartsWithSegments("/Quiz") ? "page" : null)">Quiz <small>lav din egen</small></a></li>
                    </ul>
                </details>
                <a asp-page="/Calendar">Kalender</a>
                <a asp-page="/Albums/Index">Albums</a>
                <a asp-page="/Chat/Index">Chat</a>
                <a asp-page="/Users">Brugere</a>
                @if (role is Roles.Administrator or Roles.Diktator)
                {
                    <a asp-page="/Settings/Index">Indstillinger</a>
                }
                @{ var online = Presence.Online(); }
                <a class="online-now" href="/Users#brugere" title="Online nu: @string.Join(", ", online.Select(o => o.DisplayName))"><span class="online-dot" aria-hidden="true"></span>@online.Count online</a>
                <span class="who">@User.Identity!.Name</span>
                @if (role is not null)
                {
                    <span class="role role-@role.ToLowerInvariant().Replace("ø", "o")">@role</span>
                }
            </nav>
        }
    </header>

    <main class="stage@(ViewData["StageClass"] is string stageClass ? " " + stageClass : "")">
        @if (!string.IsNullOrEmpty(status))
        {
            <p class="msg msg-ok status" role="status">@status</p>
        }
        @RenderBody()
    </main>

    <footer class="footer"><a asp-page="/Cookies">Cookies og privatliv</a></footer>
    @if (!showDisclaimer)
    {
        <partial name="_CookieNotice" />
    }
    @if (signedIn)
    {
        <script src="~/js/forms.js" asp-append-version="true" defer></script>
    }
    @if (signedIn && ViewData["HideChatWidget"] is not true)
    {
        <partial name="_ChatWidget" />
    }
  </div>
  @if (showDisclaimer)
  {
      <partial name="_Disclaimer" />
  }
</body>
</html>
