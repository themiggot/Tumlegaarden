@page
@model SettingsModel
@using Tumlegaarden.Web.Services
@{
    ViewData["Title"] = "Indstillinger";
}
<section class="window">
    <h2 class="window-title">Indstillinger</h2>
    <div class="window-body">
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="msg msg-err"></div>
            <h3>Albums</h3>
            <label asp-for="Input.MaxImageMegabytes">Maks. størrelse pr. billede (MB)</label>
            <input asp-for="Input.MaxImageMegabytes" type="number" min="1" max="@PhotoStore.MaxAllowedMegabytes" step="1" inputmode="numeric" />
            <span asp-validation-for="Input.MaxImageMegabytes" class="field-err"></span>
            <p class="hint">Gælder filen brugeren uploader, før den skaleres ned. Mellem 1 og @PhotoStore.MaxAllowedMegabytes MB. Standard er @SiteSettings.DefaultMaxImageMegabytes MB. Billeder fra nyere mobiler fylder typisk 3–10 MB.</p>
            <div class="actions"><button type="submit" class="btn btn-primary">Gem</button></div>
        </form>
    </div>
</section>
