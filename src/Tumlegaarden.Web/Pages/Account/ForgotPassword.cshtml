@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Glemt adgangskode";
}
<section class="window">
    <h2 class="window-title">Glemt kode</h2>
    <div class="window-body">
    @if (Model.Sent)
    {
        <p>Hvis adressen har en bekræftet konto, har vi sendt et link til at nulstille adgangskoden.</p>
        <p><a class="btn" asp-page="./Login">Til login</a></p>
    }
    else
    {
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="msg msg-err"></div>
            <label asp-for="Input.Email">E-mail</label>
            <input asp-for="Input.Email" autocomplete="username" autofocus />
            <span asp-validation-for="Input.Email" class="field-err"></span>
            <div class="actions"><button type="submit" class="btn btn-primary">Send link</button></div>
        </form>
        <nav class="links"><a asp-page="./Login">Tilbage til login</a></nav>
    }
    </div>
</section>
