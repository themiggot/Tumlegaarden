@page
@model SetupAuthenticatorModel
@{
    ViewData["Title"] = "To-faktor";
}
<section class="window">
    <h2 class="window-title">To-faktor</h2>
    <div class="window-body">
    @if (Model.RecoveryCodes is { Length: > 0 } codes)
    {
        <h3>Gem dine gendannelseskoder</h3>
        <p class="msg msg-ok">To-faktor er slået til.</p>
        <p>Skriv disse gendannelseskoder ned og gem dem et sikkert sted. De vises kun denne ene gang, og hver kode virker én gang, hvis du mister din telefon.</p>
        <ul class="codes">
            @foreach (var c in codes)
            {
                <li><code>@c</code></li>
            }
        </ul>
        <div class="actions"><a class="btn btn-primary" href="@Model.ReturnUrl">Fortsæt</a></div>
    }
    else
    {
        <p>To-faktor er påkrævet. Scan QR-koden med en authenticator-app (fx Microsoft Authenticator, Google Authenticator eller 1Password).</p>
        <img class="qr" src="@Model.QrDataUri" alt="QR-kode til authenticator-app" width="216" height="216" />
        <p class="hint">Kan du ikke scanne? Indtast nøglen manuelt:</p>
        <p><code class="key">@Model.SharedKey</code></p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
            <div asp-validation-summary="ModelOnly" class="msg msg-err"></div>
            <label asp-for="Input.Code">Kode fra app</label>
            <input asp-for="Input.Code" autocomplete="one-time-code" inputmode="numeric" />
            <span asp-validation-for="Input.Code" class="field-err"></span>
            <div class="actions"><button type="submit" class="btn btn-primary">Aktivér</button></div>
        </form>
    }
    </div>
    </div>
</section>
