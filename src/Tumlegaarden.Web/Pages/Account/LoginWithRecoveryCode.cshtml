@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Gendannelseskode";
}
<section class="panel">
    <h2>Gendannelse</h2>
    <p>Har du mistet adgang til din app, kan du bruge én af dine gendannelseskoder. Hver kode virker kun én gang.</p>
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
        <div asp-validation-summary="ModelOnly" class="msg msg-err"></div>
        <label asp-for="Input.Code">Gendannelseskode</label>
        <input asp-for="Input.Code" autocomplete="off" autofocus />
        <span asp-validation-for="Input.Code" class="field-err"></span>
        <button type="submit" class="btn">OK</button>
    </form>
</section>
