@page
@model LoginModel
@{
    ViewData["Title"] = "Log ind";
}
<section class="panel">
    <h2>Log ind</h2>
    <p class="hint">Kun for @@@Model.Domain</p>
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
        <div asp-validation-summary="ModelOnly" class="msg msg-err"></div>
        <label asp-for="Input.Email">E-mail</label>
        <input asp-for="Input.Email" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="field-err"></span>

        <label asp-for="Input.Password">Adgangskode</label>
        <input asp-for="Input.Password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-err"></span>

        <button type="submit" class="btn">Start</button>
    </form>
    <nav class="links">
        <a asp-page="./Register">Opret konto</a>
        <a asp-page="./ForgotPassword">Glemt adgangskode?</a>
    </nav>
</section>
