@page
@model AcceptInvitationModel
@{
    ViewData["Title"] = "Invitation";
}
<section class="window">
    <h2 class="window-title">Invitation</h2>
    <div class="window-body">
        @if (Model.Invitation is null)
        {
            <p class="msg msg-err">Invitationen er ugyldig, allerede brugt eller udløbet. Bed en administrator om en ny.</p>
            <p><a class="btn" asp-page="./Login">Til login</a></p>
        }
        else
        {
            <p>Du er inviteret som <span class="role role-@Model.RoleCss">@Model.Invitation.Role</span>. Vælg en adgangskode. Bagefter sætter du to-faktor op.</p>
            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="msg msg-err"></div>
                <input type="hidden" name="token" value="@Model.Token" />

                <label for="email">E-mail</label>
                <input id="email" value="@Model.Invitation.Email" autocomplete="username" readonly />

                <label asp-for="Input.Password">Adgangskode</label>
                <input asp-for="Input.Password" autocomplete="new-password" autofocus />
                <span asp-validation-for="Input.Password" class="field-err"></span>

                <label asp-for="Input.ConfirmPassword">Gentag adgangskode</label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-err"></span>

                <partial name="_PasswordRules" />
                <div class="actions"><button type="submit" class="btn btn-primary">Opret konto</button></div>
            </form>
        }
    </div>
</section>
