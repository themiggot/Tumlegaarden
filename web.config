<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\Tumlegaarden.Web.exe" stdoutLogEnabled="true" stdoutLogFile="..\tumlegaarden-logs\stdout" hostingModel="inprocess">
        <!-- Log: altid slået til. Skrives til /tumlegaarden-logs ved siden af public_html, så Git-importen ikke sletter den.
             En ny fil pr. opstart af appen – ryd op i mappen en gang imellem. -->
        <!-- Shadow copy: IIS kører en kopi af appen, så filerne i public_html ikke er låst,
             og "Importer fra Git" kan overskrive dem. Appen genstarter selv, når filerne ændres. -->
        <handlerSettings>
          <handlerSetting name="enableShadowCopy" value="true" />
          <handlerSetting name="shadowCopyDirectory" value="../tumlegaarden-shadow/" />
        </handlerSettings>
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- IIS' grænse er 200 MB, så billed-upload kan komme igennem. Appen selv afviser alt over 1 MB
           undtagen upload i albums (se MaxRequestBodySize i Program.cs og RequestSizeLimit på albumsiden).
           Brug IKKE <location path="Albums"> her: på Simply's IIS fjerner det ASP.NET-handleren for stien (404). -->
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="209715200" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>